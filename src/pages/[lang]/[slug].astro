---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamPage from '../../components/pages/TeamPage.astro';
import RobotsPage from '../../components/pages/RobotsPage.astro';
import OutreachPage from '../../components/pages/OutreachPage.astro';
import SponsorsPage from '../../components/pages/SponsorsPage.astro';
import NewsPage from '../../components/pages/NewsPage.astro';
import JoinPage from '../../components/pages/JoinPage.astro';
import { locales, routes, type Locale, type PageKey } from '../../data/site';
import { getPage } from '../../lib/content';
export const getStaticPaths = () => locales.flatMap((lang) => Object.entries(routes[lang]).map(([page, slug]) => ({ params: { lang, slug }, props: { page: page as PageKey } })));
const locale = Astro.params.lang as Locale;
const { page } = Astro.props as { page: PageKey };
const meta = await getPage(`${page}Page`, locale);
const views = { team: TeamPage, robots: RobotsPage, outreach: OutreachPage, sponsors: SponsorsPage, news: NewsPage, join: JoinPage } as const;
const View = views[page];
---
<BaseLayout {locale} {page} title={meta.title} description={meta.intro}>
  <article class:list={['inner-page', `page-${page}`]}>
    <header class="page-header">
      <div class="container">
        <h1>{meta.title}</h1>
        <p>{meta.intro}</p>
      </div>
    </header>
    <View {locale} />
  </article>
</BaseLayout>
