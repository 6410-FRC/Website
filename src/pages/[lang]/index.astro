---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import NewsCard from '../../components/NewsCard.astro';
import SponsorGrid from '../../components/SponsorGrid.astro';
import { locales, routeFor, ui, type Locale } from '../../data/site';
import { getNews, getPage, getSettings, img } from '../../lib/content';
export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
const t = ui[locale];
const c = await getPage('homePage', locale);
const n = await getPage('newsPage', locale);
const settings = await getSettings();
const posts = (await getNews(locale)).slice(0, 3);
const [brandName, brandNumber] = settings.teamName.split(/\s+(?=\d+$)/);
---
<BaseLayout {locale} title={c.title} description={c.description}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker">{c.hero.kicker}</p>
        <h1 id="hero-title">{brandName} {brandNumber && <span>{brandNumber}</span>}</h1>
        <p class="hero-tagline">{c.hero.tagline}</p>
        <p class="hero-lead">{c.hero.lead}</p>
        <div class="button-row">
          <a class="button" href={settings.joinFormUrl || routeFor(locale, 'join')}>{c.hero.joinLabel}</a>
          <a class="button button-outline" href={routeFor(locale, 'sponsors')}>{c.hero.sponsorLabel}</a>
        </div>
      </div>
      <MediaPlaceholder {...img(c.hero.photo)} label={t.photoSoon} ratio="4 / 3" tone="navy" class="hero-media" />
    </div>
  </section>

  <!-- About -->
  <section class="section" aria-labelledby="about-title">
    <div class="container split">
      <div>
        <h2 id="about-title">{c.about.title}</h2>
        {c.about.body.map((p) => <p>{p}</p>)}
        <a class="button button-outline" href={routeFor(locale, 'team')}>{c.about.actionLabel}</a>
      </div>
      <MediaPlaceholder {...img(c.about.photo)} label={t.photoSoon} ratio="4 / 3" tone="gray" />
    </div>
  </section>

  <!-- Robot -->
  <section class="section band-navy" aria-labelledby="robot-title">
    <div class="container split split-reverse">
      <div>
        <p class="kicker">{c.robot.label}</p>
        <h2 id="robot-title">{c.robot.title}</h2>
        <p>{c.robot.body}</p>
        <a class="button button-gold" href={routeFor(locale, 'robots')}>{c.robot.actionLabel}</a>
      </div>
      <MediaPlaceholder {...img(c.robot.photo)} label={t.photoSoon} ratio="4 / 3" tone="navy" />
    </div>
  </section>

  <!-- Team life -->
  <section class="section" aria-labelledby="life-title">
    <div class="container">
      <div class="section-title">
        <h2 id="life-title">{c.life.title}</h2>
        <p>{c.life.intro}</p>
      </div>
      <ul class="cards cards-3">
        {c.life.cards.map((card) => (
          <li class="card">
            <MediaPlaceholder {...img(card.photo)} label={t.photoSoon} ratio="4 / 3" tone="gray" />
            <div class="card-body">
              <h3>{card.title}</h3>
              <p>{card.caption}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Latest updates -->
  <section class="section band-gray" aria-labelledby="news-title">
    <div class="container">
      <div class="section-title row">
        <h2 id="news-title">{c.news.title}</h2>
        <a class="text-link" href={routeFor(locale, 'news')}>{c.news.actionLabel}</a>
      </div>
      {posts.length ? (
        <ul class="cards cards-3">
          {posts.map((post) => <NewsCard {post} {locale} categories={n.categories} soonLabel={n.soonLabel} />)}
        </ul>
      ) : <p class="note">{n.note}</p>}
    </div>
  </section>

  <!-- Sponsors -->
  <section class="section" aria-labelledby="sponsors-title">
    <div class="container">
      <div class="section-title center">
        <h2 id="sponsors-title">{c.sponsors.title}</h2>
        <p>{c.sponsors.body}</p>
      </div>
      <SponsorGrid {locale} label={c.sponsors.title} cells={6} />
      <p class="center-link"><a class="text-link" href={routeFor(locale, 'sponsors')}>{c.sponsors.actionLabel}</a></p>
    </div>
  </section>

  <!-- Support -->
  <section class="section band-navy support" aria-labelledby="support-title">
    <div class="container support-inner">
      <h2 id="support-title">{c.support.title}</h2>
      <p>{c.support.body}</p>
      <div class="button-row">
        <a class="button button-gold" href={settings.sponsorFormUrl || routeFor(locale, 'sponsors')}>{c.support.actionLabel}</a>
        <a class="button button-outline" href={settings.joinFormUrl || routeFor(locale, 'join')}>{c.support.secondaryLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>
