---
import MediaPlaceholder from '../MediaPlaceholder.astro';
import { routeFor, ui, type Locale } from '../../data/site';
import { getPage, getSettings, getSubteams, img, pick } from '../../lib/content';
const { locale } = Astro.props as { locale: Locale };
const c = await getPage('teamPage', locale);
const t = ui[locale];
const teams = await getSubteams();
const settings = await getSettings();
---
<section class="section section-tight" aria-label={t.nav.team}>
  <div class="container">
    <div class="prose">
      {c.body.map((p) => <p>{p}</p>)}
    </div>
    <MediaPlaceholder {...img(c.photo)} label={t.photoSoon} ratio="21 / 9" tone="navy" class="wide-media" />
  </div>
</section>

<section class="section band-gray" aria-labelledby="subteams-title">
  <div class="container">
    <div class="section-title">
      <h2 id="subteams-title">{c.subteams.title}</h2>
      <p>{c.subteams.intro}</p>
    </div>
    <ul class="cards cards-3">
      {teams.map(({ data }) => (
        <li class="card">
          <MediaPlaceholder {...img(data.photo)} label={t.photoSoon} ratio="3 / 2" tone="gray" />
          <div class="card-body">
            <h3>{pick(locale, data.nameEn, data.nameEs)}</h3>
            <p>{pick(locale, data.summaryEn, data.summaryEs)}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="values-title">
  <div class="container">
    <div class="section-title">
      <h2 id="values-title">{c.values.title}</h2>
    </div>
    <ul class="features">
      {c.values.items.map(({ title, body }) => (
        <li>
          <h3>{title}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section band-gray" aria-labelledby="mentors-title">
  <div class="container split">
    <div>
      <h2 id="mentors-title">{c.mentors.title}</h2>
      <p>{c.mentors.body}</p>
    </div>
    <MediaPlaceholder {...img(c.mentors.photo)} label={t.photoSoon} ratio="4 / 3" tone="navy" />
  </div>
</section>

<section class="section band-navy support" aria-labelledby="team-cta-title">
  <div class="container support-inner">
    <h2 id="team-cta-title">{c.cta.title}</h2>
    <p>{c.cta.body}</p>
    <a class="button button-gold" href={settings.joinFormUrl || routeFor(locale, 'join')}>{c.cta.actionLabel}</a>
  </div>
</section>
