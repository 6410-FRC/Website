---
import MediaPlaceholder from '../MediaPlaceholder.astro';
import { routeFor, ui, type Locale } from '../../data/site';
import { getPage, getSeasons, img, pick } from '../../lib/content';
const { locale } = Astro.props as { locale: Locale };
const c = await getPage('robotsPage', locale);
const t = ui[locale];
/* Seasons switched on in the admin: newest is featured, the rest fill the archive. */
const [featured, ...archive] = await getSeasons();
const summary = (s: (typeof archive)[number]) => pick(locale, s.data.summaryEn ?? '', s.data.summaryEs);
---
<section class="section section-tight" aria-labelledby="current-title">
  <div class="container">
    <div class="section-title">
      <h2 id="current-title">{c.current.title}</h2>
    </div>
    <div class="season-card">
      <MediaPlaceholder {...img(featured ? featured.data.photo : c.current.photo)} label={t.photoSoon} ratio="4 / 3" tone="navy" />
      <div class="season-card-body">
        <p class="kicker">{featured ? [featured.data.year, featured.data.gameName].filter(Boolean).join(' · ') : c.current.label}</p>
        <h3>{featured ? featured.data.robotName || featured.data.year : c.current.heading}</h3>
        <p>{featured ? summary(featured) : c.current.body}</p>
        {featured?.data.blueAllianceUrl && <p><a class="text-link" href={featured.data.blueAllianceUrl}>The Blue Alliance</a></p>}
      </div>
    </div>
  </div>
</section>

<section class="section band-gray" aria-labelledby="archive-title">
  <div class="container">
    <div class="section-title">
      <h2 id="archive-title">{c.archive.title}</h2>
      <p>{c.archive.body}</p>
    </div>
    <ul class="cards cards-3">
      {archive.length ? archive.map(({ data }) => (
        <li class="card">
          <MediaPlaceholder {...img(data.photo)} label={t.photoSoon} ratio="4 / 3" tone="gray" />
          <div class="card-body">
            <h3>{[data.year, data.robotName].filter(Boolean).join(' · ')}</h3>
            <p>{data.gameName || pick(locale, data.summaryEn ?? '', data.summaryEs)}</p>
            {data.blueAllianceUrl && <a class="text-link" href={data.blueAllianceUrl}>The Blue Alliance</a>}
          </div>
        </li>
      )) : [1, 2, 3].map(() => (
        <li class="card">
          <MediaPlaceholder label={t.photoSoon} ratio="4 / 3" tone="gray" />
          <div class="card-body">
            <h3>{c.archive.placeholderTitle}</h3>
            <p>{c.archive.placeholderCaption}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="process-title">
  <div class="container">
    <div class="section-title">
      <h2 id="process-title">{c.process.title}</h2>
    </div>
    <ol class="features features-numbered">
      {c.process.items.map(({ title, body }) => (
        <li>
          <h3>{title}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section band-navy support" aria-labelledby="robots-cta-title">
  <div class="container support-inner">
    <h2 id="robots-cta-title">{c.cta.title}</h2>
    <p>{c.cta.body}</p>
    <a class="button button-gold" href={routeFor(locale, 'news')}>{c.cta.actionLabel}</a>
  </div>
</section>
