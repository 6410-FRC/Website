---
/** Logo grid: real sponsor logos first, then "Your logo here" cells up to `cells`. */
import { ui, type Locale } from '../data/site';
import { getSponsors } from '../lib/content';
interface Props { locale: Locale; label: string; cells: number }
const { locale, label, cells } = Astro.props;
const sponsors = (await getSponsors()).slice(0, cells);
const empty = Math.max(0, cells - sponsors.length);
---
<ul class="logo-grid" aria-label={label}>
  {sponsors.map(({ data }) => {
    const logo = <img src={data.logo.src} alt={data.logo.alt || data.name} loading="lazy" decoding="async" />;
    return <li class="logo-cell logo-cell-real">{data.website ? <a href={data.website} title={data.name}>{logo}</a> : logo}</li>;
  })}
  {Array.from({ length: empty }).map(() => <li class="logo-cell">{ui[locale].logoSoon}</li>)}
</ul>
